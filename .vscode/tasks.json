{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DWITH_MPI=OFF"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--parallel"
            ],
            "dependsOn": "CMake: Configure Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Configure MPI Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-mpi",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DWITH_MPI=ON"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: Build MPI Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-mpi",
                "--parallel"
            ],
            "dependsOn": "CMake: Configure MPI Debug",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Configure Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-release",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DWITH_MPI=OFF"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-release",
                "--parallel"
            ],
            "dependsOn": "CMake: Configure Release",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}